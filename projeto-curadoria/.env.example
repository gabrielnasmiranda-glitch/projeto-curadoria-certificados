# ============================================================
# Plataforma de Curadoria Inteligente — variáveis de ambiente
# Copie este arquivo para ".env" na raiz do projeto e preencha.
# NUNCA faça commit do arquivo .env.
# ============================================================

# --- Aplicação (backend) ---
APP_NAME="Plataforma de Curadoria Inteligente"
ENVIRONMENT=development
DEBUG=false
# Origens permitidas do frontend (separadas por vírgula)
CORS_ORIGINS=http://localhost:3000

# --- Banco de dados (Etapa 2) ---
DATABASE_URL=postgresql+psycopg://curadoria:curadoria@localhost:5432/curadoria

# --- Segurança / autenticação (Etapa 5) ---
# Gere um valor aleatório longo, por exemplo: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- YouTube Data API (Etapa 3) ---
# Chave criada no Google Cloud Console com a YouTube Data API v3 ativada.
# Sem ela, a aba YouTube do feed mostra um aviso (nenhum vídeo é inventado).
# Cota gratuita: 10.000 unidades/dia; cada busca custa ~101 (o backend guarda cache de 10 min).
YOUTUBE_API_KEY=

# --- Provedor de IA / LLM (Etapa 4) ---
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=

# --- Frontend ---
# Esta variável é PÚBLICA (vai para o navegador). Nunca coloque chaves aqui.
# O Next.js lê variáveis de "frontend/.env.local" (não da raiz).
# Copie apenas esta linha para frontend/.env.local se a API não estiver em localhost:8000.
NEXT_PUBLIC_API_URL=http://localhost:8000
